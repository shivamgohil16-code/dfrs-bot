# ---- Discord ----
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
# If set, the /logpatrol command is registered instantly to this one server (recommended for a single-server bot).
# Leave blank to register the command globally instead (can take up to an hour to appear).
GUILD_ID=your-server-id

# Role that gets pinged when a quota log is posted (right-click the role in Discord -> Copy Role ID)
ORBAT_MANAGER_ROLE_ID=your-orbat-manager-role-id

# Channel the log is posted in. Leave blank to just reply in the channel the command was used in.
LOG_CHANNEL_ID=

# ---- Google Sheets ----
# From your Google Cloud service account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The long ID in your sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-spreadsheet-id
# Name of the tab (worksheet) the ORBAT roster is on, exactly as it appears on the tab
GOOGLE_SHEET_NAME=Sheet1

# ---- ORBAT column layout (letters, matching the screenshot) ----
COL_USERNAME=A
COL_QUOTA=C
HEADER_ROW=1

# Quota target in seconds. 30 minutes = 1800
QUOTA_TARGET_SECONDS=1800

# Timezone used for the DD/MM/YYYY date stamp
TIMEZONE=Europe/London
